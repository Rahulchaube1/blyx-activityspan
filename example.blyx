use activityspan;

fn main() {
    let levels = [0, 2, 0, 3, 0];
    let threshold = 1.0;
    let result = activityspan_bounds(levels, threshold);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
